---
---
<!-- Background Colorful Blobs -->
<div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
    <!-- Main colorful blobs (Optimized: using radial gradients instead of heavy CSS blur filters) -->
    <div class="absolute -top-[10%] -left-[10%] w-[50%] h-[50%] transform-gpu will-change-transform" style="background: radial-gradient(circle, rgba(0, 242, 255, 0.15) 0%, transparent 70%);"></div>
    <div class="absolute top-[20%] -right-[10%] w-[40%] h-[40%] transform-gpu will-change-transform" style="background: radial-gradient(circle, rgba(157, 0, 255, 0.15) 0%, transparent 70%);"></div>
    <div class="absolute -bottom-[10%] left-[20%] w-[60%] h-[60%] transform-gpu will-change-transform" style="background: radial-gradient(circle, rgba(255, 0, 60, 0.08) 0%, transparent 70%);"></div>
    
    <!-- Pattern overlay -->
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-10 pointer-events-none"></div>
    
    <!-- Subtle grain/noise for depth if needed (optional) -->
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[url('https://www.transparenttextures.com/patterns/natural-paper.png')]"></div>
</div>
